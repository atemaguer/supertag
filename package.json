{
  "name": "supertag-workspace",
  "version": "0.2.0-alpha.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc --build && pnpm build:sdk",
    "build:sdk": "pnpm --filter supertag-ai build",
    "install:cli": "pnpm install --frozen-lockfile && pnpm --filter supertag-ai build && pnpm --filter supertag-ai exec npm link",
    "uninstall:cli": "npm uninstall --global supertag-ai",
    "check": "biome check . && pnpm deploy:check && pnpm proto:check && pnpm db:check && pnpm typecheck && pnpm docs:check",
    "check:fix": "biome check --write .",
    "clean": "tsc --build --clean",
    "db:check": "pnpm --filter @supertag/store db:check",
    "docs:check": "node scripts/check-docs.mjs",
    "db:generate": "pnpm --filter @supertag/store db:generate",
    "db:migrate": "pnpm --filter @supertag/store db:migrate",
    "dev": "pnpm --filter @supertag/cli dev",
    "postinstall": "pnpm db:generate",
    "start": "node apps/cli/dist/index.js",
    "supertag": "pnpm --filter @supertag/cli dev",
    "test": "node scripts/with-test-postgres.mjs node_modules/vitest/vitest.mjs run",
    "test:verify": "node scripts/with-test-postgres.mjs scripts/test-verify.mjs",
    "test:cli-deployment": "tsx scripts/check-cli-deployment.ts",
    "test:cli:live": "tsx --conditions=development scripts/cli-operator-live.ts --live",
    "test:cursor:live": "SUPERTAG_LIVE_CURSOR=1 vitest run packages/runtime/harnesses/cursor/cursor-live.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --build --pretty false && pnpm --filter supertag-ai typecheck && pnpm typecheck:simulation && pnpm typecheck:benchmarks",
    "typecheck:benchmarks": "tsc -p tsconfig.benchmarks.json --pretty false",
    "test:manager-isolation:live": "SUPERTAG_LIVE_MANAGER_ISOLATION=1 tsx --conditions=development scripts/manager-isolation-probe.ts --live",
    "test:codex-split:docker:live": "SUPERTAG_CODEX_SPLIT_DOCKER_LIVE=1 vitest run tests/codex-split-docker-live.test.ts",
    "test:claude-split:docker:live": "SUPERTAG_CLAUDE_SPLIT_DOCKER_LIVE=1 vitest run tests/claude-split-docker-live.test.ts",
    "test:mixed-harness-shared:docker:live": "SUPERTAG_MIXED_HARNESS_SHARED_DOCKER_LIVE=1 vitest run tests/mixed-harness-shared-docker-live.test.ts",
    "test:codex-split:e2b:live": "pnpm --filter @supertag/worker-environment-shared-execution build && pnpm --filter @supertag/worker-environment-e2b exec tsx --conditions=development e2b-codex-split-live.ts",
    "test:codex-split:modal:live": "pnpm --filter @supertag/worker-environment-modal exec tsx --conditions=development modal-codex-split-live.ts",
    "test:cursor-split:modal:live": "SUPERTAG_LIVE_MODAL=1 vitest run tests/split-modal-live.test.ts -t cursor",
    "test:claude-split:modal:live": "SUPERTAG_LIVE_MODAL=1 vitest run tests/split-modal-live.test.ts -t claude-code",
    "test:shared-execution:e2b:live": "pnpm --filter @supertag/worker-environment-shared-execution build && pnpm --filter @supertag/worker-environment-e2b exec tsx --conditions=development e2b-shared-execution-live.ts",
    "test:shared-execution:modal:live": "pnpm --filter @supertag/worker-environment-shared-execution build && pnpm --filter @supertag/worker-environment-modal exec tsx --conditions=development modal-shared-execution-live.ts",
    "typecheck:simulation": "tsc -p tsconfig.simulation.json --pretty false",
    "test:mixed-harness-mcp:modal:live": "pnpm --filter @supertag/worker-environment-shared-execution build && pnpm --filter @supertag/worker-environment-modal exec tsx --conditions=development modal-mixed-mcp-live.ts",
    "proto:generate": "buf generate",
    "proto:check": "buf lint && node scripts/check-proto-generation.mjs",
    "test:shared-execution:grpc:docker": "SUPERTAG_DOCKER_GRPC_EXECUTION=1 vitest run tests/shared-execution-grpc-docker.test.ts",
    "proto:breaking": "node scripts/check-proto-breaking.mjs",
    "test:proto:python": "node scripts/proto-python-conformance.mjs",
    "test:proto:go": "SUPERTAG_RUN_GO_CONFORMANCE=1 vitest run tests/go-worklet-conformance.test.ts",
    "test:organization:docker": "SUPERTAG_DOCKER_ORGANIZATION=1 vitest run tests/organization-docker.test.ts",
    "test:worklet-artifacts:docker": "SUPERTAG_DOCKER_WORKLET_ARTIFACTS=1 vitest run tests/worklet-artifact-transfer-docker.test.ts",
    "test:worklet:grpc:docker": "SUPERTAG_DOCKER_GRPC_WORKLETS=1 vitest run tests/worklet-grpc-docker.test.ts",
    "test:mixed-harness:grpc:live": "node scripts/test-mixed-harness-grpc-live.mjs",
    "test:shared-organization:live": "node scripts/test-shared-organization-live.mjs --live",
    "test:artifact-organization:live": "tsx --conditions=development scripts/test-artifact-organization-live.ts --live",
    "deploy:generate": "tsx deploy/generate.ts && biome format --write deploy/railway/railway.json deploy/cloudflare/wrangler.json deploy/modal/runtime.json",
    "deploy:check": "node --import tsx deploy/generate.ts --check",
    "test:worklet:grpc:soak": "tsx --conditions=development scripts/worklet-grpc-docker-soak.ts",
    "test:workspace:modal:live": "SUPERTAG_LIVE_MODAL=1 node --import tsx --conditions=development packages/runtime/environments/modal/modal-workspace-conformance-live.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protobuf": "2.15.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "better-sqlite3": "12.11.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "ws": "8.21.3"
  }
}
