{
  "name": "supertag-workspace",
  "version": "0.2.0-alpha.9",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "biome check . && pnpm typecheck && pnpm docs:check",
    "check:fix": "biome check --write .",
    "clean": "tsc --build --clean",
    "docs:check": "node scripts/check-docs.mjs",
    "supertag": "cargo run --quiet --manifest-path rust/Cargo.toml --locked -p supertag-cli --bin supertag --",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protobuf": "2.15.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
