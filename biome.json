{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    }
  },
  "overrides": [
    {
      "includes": ["apps/client/src/react/**", "!apps/client/src/react/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "The terminal UI has no window: pass it in through `Platform`.",
                  "document": "The terminal UI has no document: pass it in through `Platform`.",
                  "localStorage": "The terminal UI has no localStorage: pass it in through `Platform`.",
                  "sessionStorage": "The terminal UI has no sessionStorage: pass it in through `Platform`."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/shadcn.css"],
      "css": {
        "parser": { "tailwindDirectives": true }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!harnesses/sdk/src/rust-harness/gen",
      "!sdks/typescript/gen/supertag/runtime/v2"
    ]
  }
}
