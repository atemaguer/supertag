{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    }
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/shadcn.css"],
      "css": {
        "parser": { "tailwindDirectives": true }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!packages/runtime/environments/shared-execution/src/gen",
      "!packages/runtime/transport/src/gen",
      "!packages/runtime/sdk/src/rust-harness/gen",
      "!packages/operator-api/src/gen",
      "!rust/bindings/typescript/supertag/runtime/v2",
      "!spec/manifests"
    ]
  }
}
