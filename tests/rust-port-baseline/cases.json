[
  {
    "id": "admission-retry",
    "description": "A lost acceptance response and a retry after restart identify one completed Task",
    "backends": ["sqlite", "postgresql"],
    "expected": {
      "sameTaskOnRetry": true,
      "sameTaskAfterRestart": true,
      "taskCount": 1,
      "executionCount": 1,
      "status": "completed"
    }
  },
  {
    "id": "permission-snapshot",
    "description": "Changing permissions affects new work while accepted work retains its policy",
    "backends": ["sqlite", "postgresql"],
    "expected": {
      "firstTaskActions": ["commands:execute"],
      "firstExecutionActions": ["commands:execute"],
      "laterTaskActions": ["files:write"],
      "snapshotSurvivedRestart": true
    }
  },
  {
    "id": "objective-deadline",
    "description": "A running Task survives deadline grace, then is cancelled once and limits its Objective",
    "backends": ["sqlite", "postgresql"],
    "expected": {
      "duringGraceTask": "running",
      "duringGraceObjective": "working",
      "duringGraceAborts": 0,
      "afterGraceTask": "cancelled",
      "afterGraceObjective": "limited",
      "targetTaskAborts": 1
    }
  },
  {
    "id": "durable-event-replay",
    "description": "Reopening a durable journal replays only the cursor tail and does not execute accepted work again",
    "backends": ["filesystem"],
    "expected": {
      "executionCount": 1,
      "receiptPreserved": true,
      "statusAfterRestart": "completed",
      "sequences": [1, 2, 3],
      "tailSequences": [2, 3],
      "tailMatches": true,
      "conflictingRetryRejected": true
    }
  },
  {
    "id": "workspace-verification",
    "description": "An isolated producer exports a patch from pinned source and an independent reviewer checks it",
    "backends": ["filesystem"],
    "expected": {
      "independentChecks": 2,
      "reviewPassed": true,
      "revisionMatches": true,
      "producerRemovedBeforeReview": true,
      "operatorChangesPreserved": true,
      "artifactDigestsVerified": true
    }
  }
]
