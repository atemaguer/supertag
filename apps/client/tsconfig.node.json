{
  "extends": "./tsconfig.model.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist/node",
    "tsBuildInfoFile": "dist/node/.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/model/*.ts",
    "src/node/*.ts",
    "../../sdks/typescript/src/gateway-client.ts",
