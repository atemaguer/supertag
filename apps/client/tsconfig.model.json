{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist/model",
    "tsBuildInfoFile": "dist/model/.tsbuildinfo",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2024"],
    "types": []
  },
  "include": ["src/model/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
