{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "../../..",
    "outDir": "../dist-electron/types",
    "tsBuildInfoFile": "../dist-electron/types/.tsbuildinfo",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "gateway/*.ts",
    "local/*.ts",
    "../../client/src/model/*.ts",
    "../../client/src/node/*.ts",
    "../../../sdks/typescript/src/gateway-client.ts",
    "../../../sdks/typescript/src/tunnel.ts",
    "../../../harnesses/sdk/src/rust-harness/gen/**/*.ts",
    "../src/gateway.ts",
    "../src/startup.ts",
    "../src/tag-admin.ts",
    "../src/desktop.ts",
    "../scripts/*.ts",
    "../electron-builder.config.ts"
  ],
  "exclude": ["../../client/src/**/*.test.ts"]
}
