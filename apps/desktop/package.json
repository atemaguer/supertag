{
  "name": "@supertag/desktop",
  "productName": "SuperTag",
  "version": "0.3.5",
  "description": "The SuperTag desktop app: conversations with your Tags.",
  "homepage": "https://github.com/atemaguer/supertag",
  "author": "SuperTag",
  "license": "Apache-2.0",
  "desktopName": "supertag-desktop.desktop",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && tsc --build electron && vite build && tsup",
    "electron": "tsup && electron .",
    "package:mac": "pnpm build && electron-builder --config electron-builder.config.ts --publish never --mac dir",
    "package:linux": "pnpm build && electron-builder --config electron-builder.config.ts --publish never --linux",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.2",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supertag/client": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "electron": "44.11.4",
    "electron-builder": "26.18.0",
    "lucide-react": "1.72.0",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "tailwindcss": "4.3.5",
    "tsup": "8.5.0",
    "typescript": "7.0.2",
    "use-stick-to-bottom": "1.1.6",
    "vite": "8.2.0"
  }
}
