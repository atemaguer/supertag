# Local development defaults to ~/.supertag for secrets and SQLite state.
# Override these only when an explicit location or database is needed.
# SUPERTAG_STATE_DIR=/absolute/path/to/state
# SUPERTAG_DATABASE_URL=file:/absolute/path/to/supertag.db
# Production deployments should use PostgreSQL.
SUPERTAG_POSTGRES_URL=postgresql://supertag:replace-with-password@localhost:54329/supertag

# Docker Compose self-hosting. Generate every secret value before starting.
SUPERTAG_POSTGRES_PASSWORD=
# Address where the Control Plane exposes its embedded network Gateway.
SUPERTAG_GATEWAY_BIND=127.0.0.1
SUPERTAG_GATEWAY_PORT=3434
SUPERTAG_POSTGRES_PORT=54329

# Worklet transport. Embedded uses the Control Plane's smoke-test Worker Host.
# Remote accepts enrolled Worker Hosts through the Worklet API.
SUPERTAG_WORKLET_TRANSPORT=embedded

# Remote CLI management. Never commit a populated token.
SUPERTAG_ADMIN_TOKEN=

# Optional non-interactive surface setup. Do not commit populated values.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SUPERTAG_GITHUB_TOKEN=
LARK_APP_ID=
LARK_APP_SECRET=

# Advanced self-hosted GitHub App authentication.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
