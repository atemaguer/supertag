{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supertag",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "containers": [
    {
      "class_name": "SuperTag",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SUPERTAG",
        "class_name": "SuperTag"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SuperTag"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "SUPERTAG_GATEWAY": "off"
  }
}
