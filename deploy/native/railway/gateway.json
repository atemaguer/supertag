{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "/usr/local/bin/supertag-hosted-entrypoint gateway --listen [::]:3434 --control-plane https://supertag-control-plane.railway.internal:3435 --checkpoint-directory /var/lib/supertag/checkpoints",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
