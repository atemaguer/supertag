{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "/usr/local/bin/supertag-hosted-entrypoint gateway --listen 127.0.0.1:3436 --control-plane https://supertag-control-plane.railway.internal:3434",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
