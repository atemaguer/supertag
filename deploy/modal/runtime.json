{
  "stateDirectory": "/var/lib/supertag",
  "port": 3434,
  "grpcPort": 3435,
  "startCommand": "node dist/index.js up --foreground control-plane",
  "migrationCommand": "node dist/index.js migrate",
  "healthPath": "/healthz",
  "readinessPath": "/readyz",
  "startArguments": ["node", "dist/index.js", "up", "--foreground", "control-plane"],
  "migrationArguments": ["node", "dist/index.js", "migrate"],
  "environment": {
    "SUPERTAG_DEPLOYMENT_PLATFORM": "modal",
    "SUPERTAG_STATE_DIR": "/var/lib/supertag",
    "SUPERTAG_WORKLET_TRANSPORT": "remote",
    "SUPERTAG_DEPLOYMENT_RPC_TRANSPORT": "websocket",
    "SUPERTAG_CREDENTIAL_VAULT": "vault"
  }
}
