{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/manifests/surface-account.schema.json",
  "title": "SuperTag SurfaceAccount manifest",
  "description": "A SurfaceAccount manifest, as supertag apply -f reads it. Its spec is supertag.operator.v1.SurfaceAccountManifestSpec in supertag/operator/v1/resource.proto; this file is generated from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "supertag/v1"
    },
    "kind": {
      "const": "SurfaceAccount"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "The resource's name, unique within its kind.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
          "minLength": 1
        }
      }
    },
    "spec": {
      "$ref": "#/$defs/SurfaceAccountManifestSpec"
    }
  },
  "$defs": {
    "SurfaceAccountManifestSpec": {
      "description": "The `spec` of a `SurfaceAccount` manifest: one connected account of a collaboration surface. In a manifest it is `provider` beside that provider's fields. Its secrets are references, never values; a literal value is invalid. `metadata.name` stays bound to the provider account it first named. Apply merges `configuration` and `secrets` entry by entry.\n\nReading a Surface Account returns `SurfaceAccount`, with the fields its verification recorded.",
      "oneOf": [
        {
          "description": "A Slack workspace.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "secrets"
          ],
          "properties": {
            "provider": {
              "const": "slack"
            },
            "displayName": {
              "description": "Overrides the workspace name Slack reports.",
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "description": "Its options.",
              "$ref": "#/$defs/SlackAccountConfiguration"
            },
            "secrets": {
              "description": "Where its secrets come from.",
              "$ref": "#/$defs/SlackAccountSecrets"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "configuration"
                ],
                "properties": {
                  "configuration": {
                    "required": [
                      "transport"
                    ],
                    "properties": {
                      "transport": {
                        "const": "http"
                      }
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "secrets"
                ],
                "properties": {
                  "secrets": {
                    "required": [
                      "signingSecret"
                    ]
                  }
                }
              },
              "else": {
                "required": [
                  "secrets"
                ],
                "properties": {
                  "secrets": {
                    "required": [
                      "appToken"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "description": "A GitHub token or GitHub App installation.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "secrets"
          ],
          "properties": {
            "provider": {
              "const": "github"
            },
            "displayName": {
              "description": "Overrides the account name GitHub reports.",
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "description": "Its options.",
              "$ref": "#/$defs/GithubAccountConfiguration"
            },
            "secrets": {
              "description": "Where its secrets come from.",
              "$ref": "#/$defs/GithubAccountSecrets"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "configuration"
                ],
                "properties": {
                  "configuration": {
                    "required": [
                      "auth"
                    ],
                    "properties": {
                      "auth": {
                        "const": "app"
                      }
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "configuration",
                  "secrets"
                ],
                "properties": {
                  "configuration": {
                    "required": [
                      "appId",
                      "installationId"
                    ]
                  },
                  "secrets": {
                    "required": [
                      "privateKey",
                      "webhookSecret"
                    ]
                  }
                }
              },
              "else": {
                "required": [
                  "secrets"
                ],
                "properties": {
                  "secrets": {
                    "required": [
                      "token"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "description": "A Lark or Feishu app.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "configuration",
            "secrets"
          ],
          "properties": {
            "provider": {
              "const": "lark"
            },
            "displayName": {
              "description": "Overrides the app name Lark reports.",
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "description": "Its options.",
              "$ref": "#/$defs/LarkAccountConfiguration"
            },
            "secrets": {
              "description": "Where its secrets come from.",
              "$ref": "#/$defs/LarkAccountSecrets"
            }
          }
        },
        {
          "description": "A Linear workspace.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "secrets"
          ],
          "properties": {
            "provider": {
              "const": "linear"
            },
            "displayName": {
              "description": "Overrides the workspace name Linear reports.",
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "description": "Its options.",
              "$ref": "#/$defs/LinearAccountConfiguration"
            },
            "secrets": {
              "description": "Where its secrets come from.",
              "$ref": "#/$defs/LinearAccountSecrets"
            }
          }
        },
        {
          "description": "A Microsoft Teams tenant.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "configuration",
            "secrets"
          ],
          "properties": {
            "provider": {
              "const": "teams"
            },
            "displayName": {
              "description": "The tenant's name for people. Empty: the tenant ID.",
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "description": "Its options.",
              "$ref": "#/$defs/TeamsAccountConfiguration"
            },
            "secrets": {
              "description": "Where its secrets come from.",
              "$ref": "#/$defs/TeamsAccountSecrets"
            }
          }
        }
      ]
    },
    "SlackAccountConfiguration": {
      "description": "A Slack Surface Account's options.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "description": "How events arrive. Unset: `socket`.",
          "enum": [
            "socket",
            "http"
          ]
        }
      }
    },
    "SlackAccountSecrets": {
      "description": "Where a Slack Surface Account's secrets come from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botToken"
      ],
      "properties": {
        "botToken": {
          "description": "The bot token.",
          "$ref": "#/$defs/SurfaceSecretReference"
        },
        "appToken": {
          "description": "The app-level token, for Socket Mode.",
          "$ref": "#/$defs/SurfaceSecretReference"
        },
        "signingSecret": {
          "description": "The signing secret, for HTTP events.",
          "$ref": "#/$defs/SurfaceSecretReference"
        }
      }
    },
    "SurfaceSecretReference": {
      "description": "Where a SurfaceAccount manifest takes one secret from. Never the value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretRef": {
          "description": "A named secret its caller resolves, such as an entry in the `secrets` map of `supertag.yaml`.",
          "type": "string",
          "minLength": 1
        },
        "env": {
          "description": "An environment variable the applying caller reads.",
          "type": "string",
          "minLength": 1
        },
        "file": {
          "description": "A file the applying caller reads. A relative path starts from the manifest's directory.",
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "secretRef"
              ]
            },
            {
              "required": [
                "env"
              ]
            },
            {
              "required": [
                "file"
              ]
            }
          ]
        }
      ]
    },
    "GithubAccountConfiguration": {
      "description": "A GitHub Surface Account's options.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "description": "How SuperTag authenticates. Unset: `token`.",
          "enum": [
            "token",
            "app"
          ]
        },
        "apiBaseUrl": {
          "description": "The API's base URL, for GitHub Enterprise Server.",
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "description": "The GitHub App's ID, for `auth: app`.",
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "installationId": {
          "description": "The GitHub App installation's ID, for `auth: app`.",
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "GithubAccountSecrets": {
      "description": "Where a GitHub Surface Account's secrets come from.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "description": "The fine-grained token, for `auth: token`.",
          "$ref": "#/$defs/SurfaceSecretReference"
        },
        "privateKey": {
          "description": "The GitHub App's private key, for `auth: app`.",
          "$ref": "#/$defs/SurfaceSecretReference"
        },
        "webhookSecret": {
          "description": "The webhook secret, for `auth: app`.",
          "$ref": "#/$defs/SurfaceSecretReference"
        }
      }
    },
    "LarkAccountConfiguration": {
      "description": "A Lark Surface Account's options.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId"
      ],
      "properties": {
        "appId": {
          "description": "The app's ID.",
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "description": "Which service. Unset: `lark`.",
          "enum": [
            "lark",
            "feishu"
          ]
        }
      }
    },
    "LarkAccountSecrets": {
      "description": "Where a Lark Surface Account's secrets come from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appSecret"
      ],
      "properties": {
        "appSecret": {
          "description": "The app secret.",
          "$ref": "#/$defs/SurfaceSecretReference"
        }
      }
    },
    "LinearAccountConfiguration": {
      "description": "A Linear Surface Account's options.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiBaseUrl": {
          "description": "The API's base URL.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LinearAccountSecrets": {
      "description": "Where a Linear Surface Account's secrets come from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiKey",
        "webhookSecret"
      ],
      "properties": {
        "apiKey": {
          "description": "The API key.",
          "$ref": "#/$defs/SurfaceSecretReference"
        },
        "webhookSecret": {
          "description": "The webhook signing secret.",
          "$ref": "#/$defs/SurfaceSecretReference"
        }
      }
    },
    "TeamsAccountConfiguration": {
      "description": "A Microsoft Teams Surface Account's options.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "tenantId"
      ],
      "properties": {
        "appId": {
          "description": "The bot's app ID.",
          "type": "string",
          "minLength": 1
        },
        "tenantId": {
          "description": "The tenant's ID. It may not name another account's tenant.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TeamsAccountSecrets": {
      "description": "Where a Microsoft Teams Surface Account's secrets come from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appSecret"
      ],
      "properties": {
        "appSecret": {
          "description": "The bot's app secret.",
          "$ref": "#/$defs/SurfaceSecretReference"
        }
      }
    }
  }
}
