{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/task-attempt-spec.schema.json",
  "title": "SuperTag Task Attempt Spec",
  "type": "object",
  "required": [
    "version",
    "taskId",
    "attemptId",
    "tag",
    "input",
    "authorization",
    "contextPlan",
    "workspacePlan",
    "workerProfile",
    "execution"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "taskId": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "attemptId": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "tag": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "required": ["origin", "messages"],
      "properties": {
        "origin": {
          "type": "object",
          "required": ["surface", "accountId", "scope", "sessionKey", "occurredAt"],
          "properties": {
            "surface": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "accountId": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "scope": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "sessionKey": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "occurredAt": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "source": {
              "$ref": "common.schema.json#/$defs/jsonObject"
            },
            "metadata": {
              "$ref": "common.schema.json#/$defs/jsonObject"
            }
          },
          "additionalProperties": true
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "role", "text"],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "role": {
                "enum": ["requester", "teammate", "system"]
              },
              "text": {
                "type": "string"
              },
              "actor": {
                "$ref": "common.schema.json#/$defs/actor"
              }
            },
            "additionalProperties": true
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/resourceRef"
          }
        }
      },
      "additionalProperties": true
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "version",
            "capturedAt",
            "tag",
            "origin",
            "requester",
            "permissionSets",
            "resources",
            "runtimeActions"
          ],
          "properties": {
            "version": {
              "const": 5
            },
            "capturedAt": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "tag": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "name": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                }
              },
              "additionalProperties": true
            },
            "origin": {
              "type": "object",
              "required": ["tagRouteId", "surfaceAccountId", "provider", "scope"],
              "properties": {
                "tagRouteId": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "surfaceAccountId": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "provider": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "scope": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                }
              },
              "additionalProperties": true
            },
            "requester": {
              "$ref": "common.schema.json#/$defs/actor"
            },
            "permissionSets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "roles": {
              "$ref": "#/$defs/roleSnapshots"
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["surfaceAccountId", "provider", "scope", "actions", "sources"],
                "properties": {
                  "surfaceAccountId": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "provider": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "scope": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "enum": ["origin", "permission-set"]
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "runtimeActions": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "uniqueItems": true
            },
            "mcp": {
              "description": "MCP server tools granted with target: mcp. action is server/tool; the tool part may use * as a wildcard.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "resource": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "version",
            "capturedAt",
            "tag",
            "origin",
            "requester",
            "permissionSets",
            "resources",
            "runtimeActions"
          ],
          "properties": {
            "version": {
              "const": 4
            },
            "capturedAt": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "tag": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "name": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                }
              },
              "additionalProperties": true
            },
            "origin": {
              "type": "object",
              "required": ["kind", "objectiveId", "requestedByTagId"],
              "properties": {
                "kind": {
                  "const": "internal"
                },
                "objectiveId": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "requestedByTagId": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                }
              },
              "additionalProperties": true
            },
            "requester": {
              "$ref": "common.schema.json#/$defs/actor"
            },
            "permissionSets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "roles": {
              "$ref": "#/$defs/roleSnapshots"
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["surfaceAccountId", "provider", "scope", "actions", "sources"],
                "properties": {
                  "surfaceAccountId": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "provider": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "scope": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "enum": ["origin", "permission-set"]
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "runtimeActions": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "uniqueItems": true
            },
            "mcp": {
              "description": "MCP server tools granted with target: mcp. action is server/tool; the tool part may use * as a wildcard.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "resource": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "contextPlan": {
      "type": "object",
      "required": ["version", "capturedAt", "sets"],
      "properties": {
        "version": {
          "const": 7
        },
        "capturedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "sets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "items"],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "itemKey", "type", "version", "required", "config"],
                  "properties": {
                    "id": {
                      "$ref": "common.schema.json#/$defs/nonEmptyString"
                    },
                    "itemKey": {
                      "$ref": "common.schema.json#/$defs/nonEmptyString"
                    },
                    "type": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z][a-z0-9-]*$"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "config": {
                      "$ref": "common.schema.json#/$defs/jsonObject"
                    },
                    "snapshot": {
                      "$ref": "common.schema.json#/$defs/jsonObject"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "workspacePlan": {
      "oneOf": [
        {
          "type": "object",
          "required": ["version", "status"],
          "properties": {
            "version": {
              "const": 1
            },
            "status": {
              "const": "none"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["version", "status", "selectedBy", "target"],
          "properties": {
            "version": {
              "const": 1
            },
            "status": {
              "const": "selected"
            },
            "selectedBy": {
              "enum": ["default", "origin", "request"]
            },
            "target": {
              "$ref": "#/$defs/workspaceTarget"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["version", "status", "choices"],
          "properties": {
            "version": {
              "const": 1
            },
            "status": {
              "const": "selection-required"
            },
            "choices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/workspaceTarget"
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["version", "status", "requested"],
          "properties": {
            "version": {
              "const": 1
            },
            "status": {
              "const": "unavailable"
            },
            "requested": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "description": "A named Workspace. The Worker Host resolves it to a declared checkout, or to a host-managed clone of source, and works on branch in a per-Task git worktree.",
          "required": ["version", "status", "workspace", "branch", "delivery"],
          "properties": {
            "version": {
              "const": 1
            },
            "status": {
              "const": "workspace"
            },
            "workspace": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "source": {
              "description": "Git remote captured at admission. Hosts without a declared checkout clone it; pull-request delivery pushes the Task branch to it. Never carries credentials.",
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "ref": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "branch": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "delivery": {
              "enum": ["patch", "branch", "pull-request"]
            },
            "setup": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "workerProfile": {
      "$ref": "common.schema.json#/$defs/workerProfileRef"
    },
    "session": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "sessionState": {
          "$ref": "common.schema.json#/$defs/sessionStateRef"
        },
        "persistence": {
          "type": "object",
          "required": ["controlPlaneUrl", "token"],
          "properties": {
            "controlPlaneUrl": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "token": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/taskHistoryEntry"
          }
        }
      },
      "additionalProperties": true
    },
    "coordination": {
      "type": "object",
      "required": ["controlPlaneUrl", "token"],
      "properties": {
        "controlPlaneUrl": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "token": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "objectiveId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "scope": {
          "const": "surface"
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "required": ["objectiveId"]
        },
        {
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": "surface"
            }
          }
        }
      ]
    },
    "execution": {
      "$ref": "common.schema.json#/$defs/taskExecutionRequirements"
    },
    "placement": {
      "type": "object",
      "required": ["allowedWorkerHostIds"],
      "properties": {
        "allowedWorkerHostIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "workerHostId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "workletId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "workerId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "reservation": {
          "type": "object",
          "required": ["id", "expiresAt"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" }
          },
          "additionalProperties": false
        },
        "coordinationSlot": {
          "type": "boolean",
          "description": "An Objective owner's activation. The Worker may run it in its coordination slot, one Task Attempt beyond maxConcurrency that delegated work never uses."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "roleSnapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assignmentId", "assignmentRevision", "role"],
        "properties": {
          "assignmentId": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "assignmentRevision": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "object",
            "required": [
              "id",
              "name",
              "purpose",
              "instructions",
              "revision",
              "contextSetIds",
              "permissionSetIds"
            ],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "purpose": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "instructions": { "type": "string" },
              "revision": { "type": "integer", "minimum": 1 },
              "contextSetIds": {
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                "uniqueItems": true
              },
              "permissionSetIds": {
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "workspaceTarget": {
      "type": "object",
      "required": ["provider", "surfaceAccountId", "scope", "actions"],
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "surfaceAccountId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "reference": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
