{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/worklet-transport-message.schema.json",
  "title": "SuperTag Worklet Transport Message",
  "description": "Either direction of the authenticated Worklet WebSocket protocol.",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/ready"
    },
    {
      "$ref": "#/$defs/heartbeatAck"
    },
    {
      "$ref": "#/$defs/protocolError"
    },
    {
      "$ref": "#/$defs/durableAccept"
    },
    {
      "$ref": "#/$defs/durableSelectPlacement"
    },
    {
      "$ref": "#/$defs/durableInspect"
    },
    {
      "$ref": "#/$defs/durableCancel"
    },
    {
      "$ref": "#/$defs/durableEvents"
    },
    {
      "$ref": "#/$defs/durableUnsubscribe"
    },
    {
      "$ref": "#/$defs/durableReply"
    },
    {
      "$ref": "#/$defs/durableEvent"
    },
    {
      "$ref": "#/$defs/durableEnd"
    },
    {
      "$ref": "#/$defs/durableControl"
    },
    {
      "$ref": "#/$defs/durableControlCapabilities"
    }
  ],
  "$defs": {
    "hello": {
      "type": "object",
      "required": ["type", "protocolVersions", "worklet", "credential"],
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocolVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": 18
          }
        },
        "credential": {
          "type": "string",
          "minLength": 1
        },
        "worklet": {
          "$ref": "worklet-descriptor.schema.json"
        }
      },
      "additionalProperties": true,
      "not": {
        "required": ["pairingToken"]
      }
    },
    "heartbeat": {
      "type": "object",
      "required": ["type", "at"],
      "properties": {
        "type": {
          "const": "heartbeat"
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "hostLabels": {
          "description": "The Worker Host's labels, sent only when they changed since hello or the last heartbeat.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workerConcurrency": {
          "description": "Task Attempts each Worker runs at once, by Worker ID, sent only when they changed since hello or the last heartbeat.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "changedPaths": {
          "description": "Current changed paths per readable running Task Attempt; absent when no worktree can be scanned.",
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": ["attemptId", "paths", "truncated"],
            "properties": {
              "attemptId": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "maxItems": 500,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "truncated": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "ready": {
      "type": "object",
      "required": ["type", "protocolVersion", "heartbeatIntervalMs"],
      "properties": {
        "type": {
          "const": "ready"
        },
        "protocolVersion": {
          "const": 18
        },
        "heartbeatIntervalMs": {
          "type": "integer",
          "minimum": 1
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "heartbeatAck": {
      "type": "object",
      "required": ["type", "at"],
      "properties": {
        "type": {
          "const": "heartbeat_ack"
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": true
    },
    "protocolError": {
      "type": "object",
      "required": ["type", "code", "message"],
      "properties": {
        "type": {
          "const": "protocol_error"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "supportedProtocolVersions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": true
    },
    "durableAccept": {
      "type": "object",
      "required": ["type", "requestId", "operation", "spec"],
      "properties": {
        "type": {
          "const": "durable_request"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "const": "accept"
        },
        "spec": {
          "$ref": "task-attempt-spec.schema.json"
        }
      },
      "additionalProperties": false
    },
    "durableSelectPlacement": {
      "type": "object",
      "required": ["type", "requestId", "operation", "requirements", "contextPlan", "options"],
      "properties": {
        "type": {
          "const": "durable_request"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "const": "select_placement"
        },
        "requirements": {
          "type": "object"
        },
        "contextPlan": {
          "type": "object"
        },
        "options": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "durableInspect": {
      "type": "object",
      "required": ["type", "requestId", "operation", "attemptId"],
      "properties": {
        "type": {
          "const": "durable_request"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "const": "inspect"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "durableCancel": {
      "type": "object",
      "required": ["type", "requestId", "operation", "attemptId"],
      "properties": {
        "type": {
          "const": "durable_request"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "const": "cancel"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "durableEvents": {
      "type": "object",
      "required": ["type", "requestId", "operation", "attemptId", "afterSequence"],
      "properties": {
        "type": {
          "const": "durable_request"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "const": "events"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "afterSequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "durableUnsubscribe": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": {
        "type": {
          "const": "durable_unsubscribe"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "durableReply": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": {
        "type": {
          "const": "durable_reply"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/attemptReceipt"
            },
            {
              "$ref": "#/$defs/controlAcknowledgement"
            },
            {
              "$ref": "#/$defs/controlCapabilities"
            },
            {
              "$ref": "#/$defs/executionPlacement"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "executionPlacement": {
      "type": "object",
      "required": ["workerHostId", "workletId", "workerId", "workerProfile"],
      "properties": {
        "workerHostId": {
          "type": "string",
          "minLength": 1
        },
        "workletId": {
          "type": "string",
          "minLength": 1
        },
        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "workerProfile": {
          "type": "object",
          "required": ["id", "revision"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "reservation": {
          "type": "object",
          "required": ["id", "expiresAt"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "durableEvent": {
      "type": "object",
      "required": ["type", "requestId", "item"],
      "properties": {
        "type": {
          "const": "durable_event"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "type": "object",
          "required": ["sequence", "event"],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "event": {
              "$ref": "task-attempt-event.schema.json"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "durableEnd": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": {
        "type": {
          "const": "durable_end"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "attemptReceipt": {
      "type": "object",
      "required": ["attemptId", "taskId", "specDigest", "status"],
      "properties": {
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "specDigest": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["accepted", "running", "completed", "failed", "cancelled", "unknown"]
        },
        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 0
        },
        "cancellationRequested": {
          "type": "boolean"
        },
        "control": {
          "$ref": "#/$defs/controlCapabilities"
        }
      },
      "additionalProperties": false
    },
    "controlCapabilities": {
      "type": "object",
      "required": ["version", "operations"],
      "properties": {
        "version": {
          "const": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["input", "reply", "interrupt"]
          }
        },
        "inputMode": {
          "enum": ["queue", "steer"]
        }
      },
      "additionalProperties": false,
      "if": {
        "required": ["inputMode"]
      },
      "then": {
        "properties": {
          "operations": {
            "contains": {
              "const": "input"
            }
          }
        }
      }
    },
    "controlAcknowledgement": {
      "type": "object",
      "required": ["id", "taskId", "attemptId", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["accepted", "rejected", "unknown"]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "controlCommand": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "taskId", "attemptId", "type", "text"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "input"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "taskId", "attemptId", "type", "requestId", "response"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "reply"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "response": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "taskId", "attemptId", "type"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "interrupt"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "durableControl": {
      "type": "object",
      "required": ["type", "requestId", "operation", "attemptId", "command"],
      "properties": {
        "type": {
          "const": "durable_request"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "const": "control"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "$ref": "#/$defs/controlCommand"
        }
      },
      "additionalProperties": false
    },
    "durableControlCapabilities": {
      "type": "object",
      "required": ["type", "requestId", "operation", "attemptId", "taskId"],
      "properties": {
        "type": {
          "const": "durable_request"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "const": "control_capabilities"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
