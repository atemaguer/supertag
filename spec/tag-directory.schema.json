{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/tag-directory.schema.json",
  "title": "Tag directory",
  "description": "Result of the list_tags coordination tool: one page of the organization's active Tags.",
  "type": "object",
  "required": ["tags", "total", "nextOffset"],
  "properties": {
    "tags": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/tag" }
    },
    "total": { "type": "integer", "minimum": 0 },
    "nextOffset": { "type": ["integer", "null"], "minimum": 1 },
    "guidance": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "taskCounts": {
      "type": "object",
      "required": ["running", "queued"],
      "properties": {
        "running": { "type": "integer", "minimum": 0 },
        "queued": { "type": "integer", "minimum": 0 }
      }
    },
    "tag": {
      "type": "object",
      "required": ["id", "name", "roles", "execution", "workerHosts", "taskCounts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "roles": {
          "description": "Names of the Tag's active Roles.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "execution": {
          "description": "The harness, models, and efforts the Tag's Tasks may use. An absent field allows anything its Worker Hosts offer.",
          "type": "object",
          "properties": {
            "harness": { "type": "string", "minLength": 1 },
            "model": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "effort": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["low", "medium", "high"] }
            }
          },
          "additionalProperties": true
        },
        "taskCounts": {
          "description": "Active Task counts for the caller's Objective and across all Objectives. Counts reveal no Task details.",
          "type": "object",
          "required": ["objective", "overall"],
          "properties": {
            "objective": { "$ref": "#/$defs/taskCounts" },
            "overall": { "$ref": "#/$defs/taskCounts" }
          }
        },
        "workerHosts": {
          "description": "Worker Hosts bound to the Tag. not_joined means the host is bound by name but has never joined.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "connectionStatus"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "connectionStatus": {
                "enum": ["connected", "disconnected", "revoked", "not_joined"]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
