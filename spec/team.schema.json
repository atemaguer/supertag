{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/team.schema.json",
  "title": "Team",
  "type": "object",
  "required": [
    "id",
    "objectiveId",
    "name",
    "leadTagId",
    "memberTagIds",
    "parentTeamId",
    "maxConcurrency",
    "status",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "objectiveId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "leadTagId": { "type": "string", "minLength": 1 },
    "memberTagIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "parentTeamId": { "type": ["string", "null"] },
    "maxConcurrency": {
      "description": "Optional throttle on running Task Attempts of this Team's own members; null means Worker Host capacity is the only limit.",
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 1000
    },
    "status": { "enum": ["active", "dissolved"] },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
