{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/worker-host-descriptor.schema.json",
  "title": "SuperTag Worker Host Descriptor",
  "type": "object",
  "required": ["id", "workers"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "workspaces": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "description": "Workspace names with a checkout declared on this Worker Host. Checkout paths stay on the host. Advertised when at least one profile can use a checkout in place.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
      }
    },
    "labels": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "description": "Placement labels this Worker Host advertises: automatic ones such as linux, arm64, harness:codex, and workspace:NAME, plus operator-declared labels. Self-reported; the Control Plane uses them for placement, never for access.",
      "items": {
        "type": "string",
        "anyOf": [
          { "pattern": "^[a-z0-9][a-z0-9._:-]{0,62}$" },
          { "pattern": "^workspace:[a-z0-9][a-z0-9_-]{0,62}$" }
        ]
      }
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "capabilities",
          "profiles",
          "contextTypes",
          "profileCapabilities"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "type": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "capabilities": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["id", "version"],
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": true
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "common.schema.json#/$defs/workerProfileRef"
            }
          },
          "contextTypes": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["type", "versions"],
              "properties": {
                "type": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "versions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "maxConcurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Task Attempts the Worker runs at once. An Attempt whose placement sets coordinationSlot may run beyond it, at most one at a time."
          },
          "profileCapabilities": {
            "type": "array",
            "maxItems": 256,
            "description": "When present, authoritative support for each exact profile revision; omitted profiles are unsupported. Worker-wide capabilities remain the conservative fallback for older routers.",
            "items": {
              "type": "object",
              "required": ["profile", "capabilities", "contextTypes"],
              "properties": {
                "profile": {
                  "$ref": "common.schema.json#/$defs/workerProfileRef"
                },
                "capabilities": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "required": ["id", "version"],
                    "properties": {
                      "id": {
                        "$ref": "common.schema.json#/$defs/nonEmptyString"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "contextTypes": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "required": ["type", "versions"],
                    "properties": {
                      "type": {
                        "$ref": "common.schema.json#/$defs/nonEmptyString"
                      },
                      "versions": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 256,
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "harness": {
                  "type": "string",
                  "minLength": 1
                },
                "models": {
                  "description": "Models this profile's harness serves; the first is its default. A Task that names a model runs only on a profile that lists it.",
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "efforts": {
                  "description": "Reasoning efforts this profile's harness applies. Omitted when the harness has no effort option.",
                  "type": "array",
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "enum": ["low", "medium", "high"]
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
