{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/surface-account-manifest.schema.json",
  "title": "SuperTag SurfaceAccount manifest",
  "description": "A declared Surface Account, applied with supertag apply -f or provisioned by a caller such as supertag.yaml. Secrets are references only; a literal value is invalid. Apply resolves the references, verifies the values with the provider as supertag setup surface does, and stores them in the credential vault. Unknown fields are rejected so typos fail early. Status is observed, never declared.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "supertag/v1" },
    "kind": { "const": "SurfaceAccount" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "description": "The account's name in SuperTag. Tag locations may name the account by it.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
        }
      }
    },
    "spec": {
      "oneOf": [
        { "$ref": "#/$defs/slack" },
        { "$ref": "#/$defs/github" },
        { "$ref": "#/$defs/lark" },
        { "$ref": "#/$defs/linear" },
        { "$ref": "#/$defs/teams" }
      ]
    }
  },
  "$defs": {
    "secretReference": {
      "description": "Where one secret comes from. secretRef names a secret the caller resolves, such as an entry in the secrets map of supertag.yaml; env and file are read by the CLI at apply time. A relative file path resolves against the manifest's directory.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretRef"],
          "properties": { "secretRef": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": { "env": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "displayName": {
      "description": "Overrides the name the provider reports, such as the Slack workspace name.",
      "type": "string",
      "minLength": 1
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "secrets"],
      "properties": {
        "provider": { "const": "slack" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transport": {
              "description": "socket (default) uses Socket Mode with an app-level token; http receives signed events at the Gateway.",
              "enum": ["socket", "http"]
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["botToken"],
          "properties": {
            "botToken": { "$ref": "#/$defs/secretReference" },
            "appToken": { "$ref": "#/$defs/secretReference" },
            "signingSecret": { "$ref": "#/$defs/secretReference" }
          }
        }
      },
      "if": {
        "required": ["configuration"],
        "properties": {
          "configuration": {
            "required": ["transport"],
            "properties": { "transport": { "const": "http" } }
          }
        }
      },
      "then": { "properties": { "secrets": { "required": ["signingSecret"] } } },
      "else": { "properties": { "secrets": { "required": ["appToken"] } } }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "secrets"],
      "properties": {
        "provider": { "const": "github" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "auth": {
              "description": "token (default) uses a fine-grained token; app uses a GitHub App installation.",
              "enum": ["token", "app"]
            },
            "apiBaseUrl": { "type": "string", "minLength": 1 },
            "appId": {
              "description": "GitHub App ID, for auth: app.",
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "installationId": {
              "description": "GitHub App installation ID, for auth: app.",
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": { "$ref": "#/$defs/secretReference" },
            "privateKey": { "$ref": "#/$defs/secretReference" },
            "webhookSecret": { "$ref": "#/$defs/secretReference" }
          }
        }
      },
      "if": {
        "required": ["configuration"],
        "properties": {
          "configuration": { "required": ["auth"], "properties": { "auth": { "const": "app" } } }
        }
      },
      "then": {
        "required": ["configuration"],
        "properties": {
          "configuration": { "required": ["appId", "installationId"] },
          "secrets": { "required": ["privateKey", "webhookSecret"] }
        }
      },
      "else": { "properties": { "secrets": { "required": ["token"] } } }
    },
    "lark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "configuration", "secrets"],
      "properties": {
        "provider": { "const": "lark" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appId"],
          "properties": {
            "appId": { "type": "string", "minLength": 1 },
            "domain": { "description": "lark (default) or feishu.", "enum": ["lark", "feishu"] }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appSecret"],
          "properties": { "appSecret": { "$ref": "#/$defs/secretReference" } }
        }
      }
    },
    "linear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "secrets"],
      "properties": {
        "provider": { "const": "linear" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "apiBaseUrl": { "type": "string", "minLength": 1 } }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiKey", "webhookSecret"],
          "properties": {
            "apiKey": { "$ref": "#/$defs/secretReference" },
            "webhookSecret": { "$ref": "#/$defs/secretReference" }
          }
        }
      }
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "configuration", "secrets"],
      "properties": {
        "provider": { "const": "teams" },
        "displayName": {
          "description": "The tenant's display name; defaults to the tenant ID.",
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appId", "tenantId"],
          "properties": {
            "appId": { "type": "string", "minLength": 1 },
            "tenantId": { "type": "string", "minLength": 1 }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appSecret"],
          "properties": { "appSecret": { "$ref": "#/$defs/secretReference" } }
        }
      }
    }
  }
}
