{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/tag-message.schema.json",
  "title": "Experimental Tag message v1",
  "type": "object",
  "required": [
    "id",
    "senderTagId",
    "recipientTagId",
    "objectiveId",
    "idempotencyKey",
    "type",
    "body",
    "status",
    "attemptCount",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "senderTagId": {
      "type": "string",
      "minLength": 1
    },
    "recipientTagId": {
      "type": "string",
      "minLength": 1
    },
    "objectiveId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "inReplyTo": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "message",
        "delegation.requested",
        "delegation.accepted",
        "delegation.declined",
        "clarification.requested",
        "progress.updated",
        "result.submitted",
        "cancellation.requested",
        "priority.proposed",
        "priority.accepted",
        "priority.declined"
      ]
    },
    "body": {
      "type": "object"
    },
    "status": {
      "enum": ["pending", "processing", "processed", "failed"]
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "processedAt": {
      "type": "string",
      "format": "date-time"
    },
    "bodyPrunedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
