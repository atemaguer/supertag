{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/worklet-descriptor.schema.json",
  "title": "SuperTag Worklet Descriptor",
  "type": "object",
  "required": ["id", "protocolVersion", "host", "durableProtocolVersion"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "protocolVersion": {
      "const": 1
    },
    "host": {
      "$ref": "worker-host-descriptor.schema.json"
    },
    "controlProtocolVersion": {
      "const": 1,
      "description": "Optional durable native control extension. Omission means unsupported."
    },
    "durableProtocolVersion": {
      "const": 1,
      "description": "Required durable execution marker for Worklet transport protocol 18."
    }
  },
  "additionalProperties": true
}
