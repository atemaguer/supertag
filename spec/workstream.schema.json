{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/workstream.schema.json",
  "title": "Experimental Workstream v1",
  "description": "A Team's channel. Every Team has exactly one, created with the Team; its ID is the Team ID. Every field except createdAt is read from the Team: title is the Team name, ownerTagId the Team lead, participantTagIds the Team's members including its lead, and objectiveId the Team's governing Objective.",
  "type": "object",
  "required": [
    "id",
    "objectiveId",
    "title",
    "ownerTagId",
    "participantTagIds",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objectiveId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "ownerTagId": {
      "type": "string",
      "minLength": 1
    },
    "participantTagIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
