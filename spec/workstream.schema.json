{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atemaguer/supertag/main/spec/workstream.schema.json",
  "title": "Workstream post",
  "description": "One post in a Team's Workstream, the shared record every member reads. A post wakes nobody; each Tag in `to` receives it as a Mailbox message.",
  "type": "object",
  "required": ["id", "teamId", "authorTagId", "to", "body", "sequence", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "teamId": { "type": "string", "minLength": 1 },
    "authorTagId": { "type": "string", "minLength": 1 },
    "to": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "body": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "sourceTaskId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
