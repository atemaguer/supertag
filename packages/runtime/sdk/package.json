{
  "name": "@supertag/worker-sdk",
  "version": "0.2.0-alpha.9",
  "private": true,
  "type": "module",
  "exports": {
    "./redaction": {
      "types": "./dist/redaction.d.ts",
      "development": "./src/redaction.ts",
      "default": "./dist/redaction.js"
    },
    "./internal/process-inventory": {
      "types": "./dist/process-inventory.d.ts",
      "development": "./src/process-inventory.ts",
      "default": "./dist/process-inventory.js"
    },
    "./internal/rust-harness": {
      "types": "./dist/rust-harness/index.d.ts",
      "development": "./src/rust-harness/index.ts",
      "default": "./dist/rust-harness/index.js"
    },
    "./internal/rust-workspace-provider": {
      "types": "./dist/rust-workspace-provider/index.d.ts",
      "development": "./src/rust-workspace-provider/index.ts",
      "default": "./dist/rust-workspace-provider/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supertag/core": "workspace:*",
    "zod": "4.4.3"
  }
}
