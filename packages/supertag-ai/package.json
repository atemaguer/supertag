{
  "name": "supertag-ai",
  "version": "0.2.0-alpha.6",
  "description": "Define outcomes, not tasks: SuperTag runs AI engineering teams that deliver them.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "SuperTag contributors",
  "homepage": "https://github.com/atemaguer/supertag#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atemaguer/supertag.git",
    "directory": "packages/supertag-ai"
  },
  "bugs": {
    "url": "https://github.com/atemaguer/supertag/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "collaboration",
    "harness",
    "mcp",
    "supertag",
    "workers"
  ],
  "sideEffects": false,
  "bin": {
    "supertag": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./coordination": {
      "types": "./dist/coordination.d.ts",
      "import": "./dist/coordination.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./spec/*": "./dist/spec/*",
    "./surfaces": {
      "types": "./dist/surfaces.d.ts",
      "import": "./dist/surfaces.js"
    },
    "./control-plane": {
      "types": "./dist/control-plane.d.ts",
      "import": "./dist/control-plane.js"
    },
    "./harnesses/codex": {
      "types": "./dist/harnesses/codex.d.ts",
      "import": "./dist/harnesses/codex.js"
    },
    "./harnesses/claude-code": {
      "types": "./dist/harnesses/claude-code.d.ts",
      "import": "./dist/harnesses/claude-code.js"
    },
    "./environments/e2b": {
      "types": "./dist/environments/e2b.d.ts",
      "import": "./dist/environments/e2b.js"
    },
    "./environments/shared-execution": {
      "types": "./dist/environments/shared-execution.d.ts",
      "import": "./dist/environments/shared-execution.js"
    },
    "./resources/github": {
      "types": "./dist/resources/github.d.ts",
      "import": "./dist/resources/github.js"
    },
    "./package.json": "./package.json",
    "./messaging": {
      "types": "./dist/messaging.d.ts",
      "import": "./dist/messaging.js"
    },
    "./harnesses/opencode": {
      "types": "./dist/harnesses/opencode.d.ts",
      "import": "./dist/harnesses/opencode.js"
    },
    "./environments/modal": {
      "types": "./dist/environments/modal.d.ts",
      "import": "./dist/environments/modal.js"
    },
    "./harnesses/cursor": {
      "types": "./dist/harnesses/cursor.d.ts",
      "import": "./dist/harnesses/cursor.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --workspace-root exec tsc --build && tsup && node scripts/copy-migrations.mjs",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "test:package": "pnpm build && publint && attw --pack . --profile esm-only && node scripts/verify-cli.mjs && node scripts/verify-external-worker.mjs",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@aws-sdk/client-s3": "3.1131.0",
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@cursor/sdk": "1.0.37",
    "@inquirer/prompts": "8.5.2",
    "@larksuiteoapi/lark-mcp": "0.5.1",
    "@larksuiteoapi/node-sdk": "1.72.0",
    "@microsoft/teams.apps": "2.0.15",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex-sdk": "0.156.0",
    "@slack/socket-mode": "3.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "26.1.2",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "tar": "7.5.22",
    "ws": "8.21.3",
    "yaml": "2.8.1",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "e2b": "2.38.3",
    "modal": "0.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/ws": "8.18.1",
    "publint": "0.3.23",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
